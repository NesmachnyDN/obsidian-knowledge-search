{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "plugin/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
