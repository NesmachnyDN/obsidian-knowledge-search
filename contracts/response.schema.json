{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oks/v1/response.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "ok": {
          "const": true
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "sourceId": {
                  "const": "oks-01a-note"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8193
                },
                "excerpt": {
                  "type": "string",
                  "maxLength": 8192,
                  "pattern": "^[^\\r\\n]*$",
                  "description": "Valid Unicode scalar values only; additionally at most 8192 UTF-8 bytes."
                }
              },
              "required": [
                "sourceId",
                "digest",
                "line",
                "excerpt"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "version",
        "id",
        "ok",
        "evidence"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "UNSUPPORTED_VERSION",
                "UNSUPPORTED_METHOD",
                "FIXTURE_REJECTED"
              ]
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
