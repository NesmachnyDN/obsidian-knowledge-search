{
  "name": "oks-synthetic-evidence-probe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:python": "python3 -I -B -m unittest discover -s tests -p 'test_*.py'",
    "benchmark:standalone": "node scripts/standalone-benchmark.mjs",
    "licenses": "node scripts/licenses.mjs",
    "package:standalone": "npm run build && node scripts/standalone-package.mjs pack",
    "test:package": "npm run package:standalone && node --test tests/package-standalone.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3"
  }
}
